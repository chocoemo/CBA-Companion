// CBA Companion — core data model
// Encodes StatsPlus API shapes + CBA Constitution rules (contracts, service time, draft, picks)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeagueTier {
  PREMIER // Premier League (PL)
  SILVER  // Silver League (SL)
  BRONZE  // Bronze League (BL)
}

// OOTP Level IDs collapsed to the CBA's actual affiliate names.
// All three LeagueTier values map to OOTP "ml" (level 1) in the raw data —
// CBA just runs 3 major leagues under promotion/relegation.
enum MinorLevel {
  MAJORS     // ML (PL/SL/BL — see LeagueTier on Team)
  RESERVES   // RES  ~ AAA
  DEV_A      // DEV-A ~ AA
  DEV_B      // DEV-B ~ A
  YOUTH_ACADEMY // YA ~ Rookie, currently capped at age 19 per constitution 2.4.1 (subject to change)
  INTERNATIONAL_COMPLEX // OOTP level code 8 — each org's own int'l academy (IFA signees), distinct from the "International" tab's unaffiliated foreign leagues
}

enum RatingSource {
  SCOUT // your own team's scouted grades — ALWAYS the default view
  OSA
}

enum AssetType {
  PLAYER
  PICK
  CASH
}

enum TradeSide {
  A
  B
}

model Team {
  id                Int         @id // StatsPlus team_id
  name              String
  nickname          String
  abbr              String      // from /lgdata's teams[].abbr — the REAL abbreviation, not a guess
  leagueId          Int?        // from /lgdata's teams[].league_id — drives CBA-vs-international filtering
  tier              LeagueTier?
  divisionId        Int?
  parentTeamId      Int?
  // Branding — only Calgary is pre-seeded; every team can carry its own theme.
  colorPrimary      String?
  colorSecondary    String?
  colorTertiary     String?
  colorAccent       String?
  isDefaultControlling Boolean  @default(false)

  players           Player[]
  contracts         Contract[]
  picksOriginal     Pick[]      @relation("OriginalTeam")
  picksOwned        Pick[]      @relation("CurrentOwner")
  draftResults      DraftResult[]
  gmStints          GMStint[]
  tradesAsA         Trade[]     @relation("TeamA")
  tradesAsB         Trade[]     @relation("TeamB")
  standingsSnapshots StandingsSnapshot[]
}

model GM {
  id            Int       @id @default(autoincrement())
  displayName   String
  active        Boolean   @default(true)
  stints        GMStint[]
  tendencyProfiles GMTendencyProfile[]
  tradesAsA     Trade[]   @relation("GMA")
  tradesAsB     Trade[]   @relation("GMB")
}

// Tracks which team a GM controlled and when — lets tendencies follow the
// person, not the seat, and lets you "reset" a team's pattern on a GM change
// without losing the old GM's history.
model GMStint {
  id        Int       @id @default(autoincrement())
  gmId      Int
  gm        GM        @relation(fields: [gmId], references: [id])
  teamId    Int
  team      Team      @relation(fields: [teamId], references: [id])
  startDate DateTime
  endDate   DateTime?

  @@index([teamId])
}

// A computed snapshot of "what does this GM seem to like" — regenerated
// periodically from their trade + draft history. Archived (not deleted) on
// reset so old-GM patterns stay queryable historically.
model GMTendencyProfile {
  id           Int      @id @default(autoincrement())
  gmId         Int
  gm           GM       @relation(fields: [gmId], references: [id])
  generatedAt  DateTime @default(now())
  archived     Boolean  @default(false)
  archivedAt   DateTime?
  summary      Json     // free-form: tool preferences, position tendencies, buy/sell patterns, pick-vs-player lean, etc.
  notes        String?
}

model Player {
  id                Int      @id // StatsPlus player_id — the join key for every import
  firstName         String
  lastName          String
  teamId            Int?
  team              Team?    @relation(fields: [teamId], references: [id])
  organizationId    Int?
  leagueId          Int?     // links to League.id — drives the International tab split
  level             MinorLevel?
  pos               String?  // decoded from OOTP Pos code
  role              String?  // decoded from OOTP Role code (SP/RP/CL) for pitchers
  age               Int?
  bats              String?  // R / L / S
  throws            String?  // R / L
  retired           Boolean  @default(false)
  draftYear         Int?
  draftRound        Int?
  draftOverallPick  Int?
  isCollege         Boolean? // from /draftv2's "College" column: 1=college, 0=high schooler. No school name is provided by the API.
  height            Int?     // from the ratings export's "Height" field (cm)
  mlbServiceYears   Int?
  mlbServiceDays    Int?
  isOn40Man         Boolean  @default(false)
  isActive          Boolean  @default(false)
  rawImport         Json?    // full raw /players row, for fields we haven't modeled explicitly yet
  updatedAt         DateTime @updatedAt

  ratings           RatingSnapshot[]
  contracts         Contract[]
  draftResult       DraftResult?
  tradeAssets       TradeAsset[]
  prospectRankings  ProspectRanking[]

  @@index([teamId])
  @@index([lastName])
}

// One row per (player, source, capture date). Keeping full history is what
// lets you see a prospect's grades change over time, and lets "scout vs OSA"
// be a toggle rather than an overwrite. Tool grades live in a JSON blob
// because hitters/pitchers carry different tool sets and the league may add
// custom scouted categories (e.g. personality/makeup) later — those become
// new keys here, and get a TooltipDef entry rather than a schema change.
model RatingSnapshot {
  id          Int          @id @default(autoincrement())
  playerId    Int
  player      Player       @relation(fields: [playerId], references: [id])
  source      RatingSource
  capturedAt  DateTime     @default(now())
  overall     Int?         // 20-80 scale; can exceed 80 per league convention
  potential   Int?
  tools       Json         // e.g. { "contact":55, "power":60, "eye":50, "babip":52, "stuff":0, "control":0, ... }
  raw         Json?        // full raw ratings dump row

  @@index([playerId, source, capturedAt])
}

// Organizational / league-wide prospect list snapshots, so graduations
// mid-season and rank movement over time are trackable, not just a live number.
model ProspectRanking {
  id          Int      @id @default(autoincrement())
  playerId    Int
  player      Player   @relation(fields: [playerId], references: [id])
  scope       String   // "ORG:<teamId>" | "LEAGUE:PL" | "LEAGUE:SL" | "LEAGUE:BL" | "LEAGUE:ALL"
  rank        Int
  asOf        DateTime @default(now())
  source      RatingSource @default(SCOUT)

  @@index([scope, asOf])
}

model Contract {
  id                  Int      @id @default(autoincrement())
  playerId            Int
  player              Player   @relation(fields: [playerId], references: [id])
  teamId              Int
  team                Team     @relation(fields: [teamId], references: [id])
  seasonYear          Int
  years               Int
  currentYear         Int
  salaryByYear        Json     // salary0..salary14 from S+, indexed by contract year
  isPreArbMinimum     Boolean  @default(false) // house rule: <6 yrs service defaults to $500K unless extended
  extensionEligible   Boolean  @default(false) // true once player has 3+ yrs ML service (constitution 2.7.1/2.7.3)
  hasBeenExtended     Boolean  @default(false) // extensions only allowed once per constitution
  rawImport           Json?

  @@index([playerId])
  @@index([teamId])
}

// A single draft pick, one row per (year, round, original team). Ownership
// moves via TradeAsset rows referencing this pick — pickValue* fields are
// snapshotted from the live curve at read time, not stored redundantly here.
model Pick {
  id                Int      @id @default(autoincrement())
  draftYear         Int
  round             Int
  pickInRound       Int?     // position within the round — combined with round for display, e.g. "2-19"
  overallSlot       Int?     // the TRUE unique identifier of a pick within a draft year — a team can have
                              // multiple picks in one round (comp/supplemental), so this (not round+team)
                              // is what must be unique. Learned the hard way: round+team collided and
                              // silently overwrote extra picks from the same team in the same round.
  originalTeamId    Int
  originalTeam      Team     @relation("OriginalTeam", fields: [originalTeamId], references: [id])
  currentOwnerTeamId Int
  currentOwnerTeam  Team     @relation("CurrentOwner", fields: [currentOwnerTeamId], references: [id])
  tradedTwice       Boolean  @default(false) // flags the $2M fine scenario (constitution 2.8.3)

  tradeAssets       TradeAsset[]
  draftResult       DraftResult?

  @@unique([draftYear, overallSlot])
  @@index([currentOwnerTeamId])
}

model DraftResult {
  id            Int         @id @default(autoincrement())
  pickId        Int         @unique
  pick          Pick        @relation(fields: [pickId], references: [id])
  playerId      Int         @unique
  player        Player      @relation(fields: [playerId], references: [id])
  teamId        Int
  team          Team        @relation(fields: [teamId], references: [id])
  year          Int
  round         Int
  pickInRound   Int?
  overallSlot   Int
  intendedLevel MinorLevel? // where YOU plan to assign this pick once eligible — set manually, not synced
}

// Singleton settings row (id is always 1) — fit-score tool weights and
// roster min/max by position group. Read by the Draft tab and (later)
// roster-compliance checks.
model Settings {
  id                Int   @id @default(1)
  fitWeights        Json  // { hitter: {...}, pitcher: {...} } — see lib/fitScore.ts for the default (Choco-confirmed) set
  pitcherBonuses    Json? // GB/FB-type + SP bonuses added to pitcher fit score — see DEFAULT_PITCHER_BONUSES
  includeMyPark     Boolean @default(false) // scaffolding — the actual park-factor-adjusted fit score math isn't built yet
  includedLeagueParks Json? // { [teamId]: boolean } — which teams' parks count toward a future league-adjusted Fit Score
  rosterMinC        Int?
  rosterMaxC        Int?
  rosterMinIF       Int?
  rosterMaxIF       Int?
  rosterMinOF       Int?
  rosterMaxOF       Int?
  rosterMinP        Int?
  rosterMaxP        Int?
  updatedAt         DateTime @updatedAt
}

model Trade {
  id          Int          @id @default(autoincrement())
  date        DateTime
  teamAId     Int
  teamA       Team         @relation("TeamA", fields: [teamAId], references: [id])
  teamBId     Int
  teamB       Team         @relation("TeamB", fields: [teamBId], references: [id])
  gmAId       Int?
  gmA         GM?          @relation("GMA", fields: [gmAId], references: [id])
  gmBId       Int?
  gmB         GM?          @relation("GMB", fields: [gmBId], references: [id])
  isLoan      Boolean      @default(false) // constitution 2.6.5 — loans follow trade rules but expire
  loanReturnsAt DateTime?
  notes       String?
  assets      TradeAsset[]
}

model TradeAsset {
  id               Int       @id @default(autoincrement())
  tradeId          Int
  trade            Trade     @relation(fields: [tradeId], references: [id])
  side             TradeSide // which team SENT this asset (A or B)
  assetType        AssetType
  playerId         Int?
  player           Player?   @relation(fields: [playerId], references: [id])
  pickId           Int?
  pick             Pick?     @relation(fields: [pickId], references: [id])
  cashAmount       Float?
  valueAtTradeTime Float?    // snapshot of pick-chart / player value at the moment of trade, for later +/- comparisons

  @@index([tradeId])
  @@index([playerId])
  @@index([pickId])
}

// The self-adjusting pick value chart. Seeded once from a Jimmy-Johnson-style
// curve, then a new row is written per slot whenever real trades cause a
// recalculation — so the chart's own history is inspectable, not just its
// current state.
model PickValueCurve {
  id            Int      @id @default(autoincrement())
  overallSlot   Int
  value         Float
  effectiveDate DateTime @default(now())
  derivedFrom   String   @default("seed") // "seed" | "trade:<tradeId>" | "manual"

  @@index([overallSlot, effectiveDate])
}

model StandingsSnapshot {
  id        Int      @id @default(autoincrement())
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id])
  asOf      DateTime
  wins      Int
  losses    Int
  ties      Int      @default(0)
  gb        Float?
  streak    Int?     // positive = win streak of that length, negative = loss streak (StatsPlus sends a plain int, not "W3"/"L2")
  raw       Json?

  @@index([teamId, asOf])
}

// Every league in the save, from /lgdata — the CBA's own PL/SL/BL (+ their
// affiliate levels) AND any unaffiliated foreign leagues (an NPB/KBO-style
// league with no tie to a CBA org). isCbaAffiliated starts false for
// anything new and gets confirmed manually via Settings once real league
// IDs are visible, rather than guessed automatically and possibly wrong.
// Every league in the save, from /lgdata — the CBA's own PL/SL/BL AND any
// unaffiliated foreign leagues. `primaryLeague` is /lgdata's own
// "top-level S+ league" flag, which is the authoritative signal for CBA
// affiliation (previously guessed/manually classified — this replaces
// that guesswork). isCbaAffiliated defaults from primaryLeague on every
// sync; the Settings page can still override it for edge cases.
model League {
  id               Int      @id // StatsPlus league_id
  name             String
  abbr             String?
  level            Int?     // Level ID, see reference table (1=ml, 2=aaa, ...)
  parentLeagueId   Int?
  primaryLeague    Boolean  @default(false)
  isCbaAffiliated  Boolean  @default(false)
  tier             LeagueTier? // best-effort name match (premier/silver/bronze) — unconfirmed until checked against real names
  raw              Json?
  updatedAt        DateTime @updatedAt
}

// From /ballparks — "OOTP park factors, capacity, stadium type, playing
// surface" per the docs. Exact field names not confirmed against a real
// sample yet, so `raw` is kept alongside whatever's been mapped so far —
// this is what the (currently unbuilt) park-factor-adjusted Fit Score
// would eventually read from.
model Ballpark {
  teamId       Int      @id
  name         String?
  capacity     Int?
  stadiumType  String?  // open/dome/retractable, guessed field name
  surface      String?  // grass/turf, guessed field name
  hrFactor     Float?
  doublesFactor Float?
  triplesFactor Float?
  raw          Json?
  updatedAt    DateTime @updatedAt
}

// From /playerbatstatsv2 (split=1, overall only for now). Column names are
// best-effort guesses at OOTP's own export naming (snake_case) — not yet
// confirmed against a real sample. `raw` always keeps the full row
// regardless, same pattern as everywhere else this applies.
model PlayerSeasonBatting {
  id       Int   @id @default(autoincrement())
  playerId Int
  year     Int
  teamId   Int?
  leagueId Int?
  g        Int?
  gs       Int?
  h        Int?
  doubles  Int?
  triples  Int?
  hr       Int?
  r        Int?
  rbi      Int?
  sb       Int?
  cs       Int?
  bb       Int?
  k        Int?
  avg      Float?
  obp      Float?
  slg      Float?
  ops      Float?
  opsPlus  Float?
  wrcPlus  Float?
  wpa      Float?
  war      Float?
  raw      Json?

  @@unique([playerId, year])
  @@index([teamId])
}

model PlayerSeasonPitching {
  id       Int   @id @default(autoincrement())
  playerId Int
  year     Int
  teamId   Int?
  leagueId Int?
  g        Int?
  gs       Int?
  qs       Int?
  w        Int?
  l        Int?
  sv       Int?
  bs       Int?
  r        Int?
  er       Int?
  era      Float?
  whip     Float?
  ip       Float?
  bb       Int?
  k        Int?
  eraPlus  Float?
  fipMinus Float?
  wpa      Float?
  war      Float?
  raw      Json?

  @@unique([playerId, year])
  @@index([teamId])
}


// Editable tooltip text for every column, including columns that show up
// for the first time from a new CSV/JSON import.
model TooltipDef {
  id          Int      @id @default(autoincrement())
  fieldKey    String   @unique
  label       String
  description String
  source      String   @default("BUILTIN") // "BUILTIN" | "IMPORTED"
}

// Saved "at least / at most / is / is not" filter sets per tab, so a Big
// Board or Power/Speed-style view can be redefined without touching code.
model FilterPreset {
  id        Int      @id @default(autoincrement())
  scope     String   // e.g. "big_board", "power_speed", "starter_projects"
  name      String
  rules     Json     // [{ field, op: "gte"|"lte"|"eq"|"neq", value }]
  createdAt DateTime @default(now())
}

model SyncLog {
  id         Int      @id @default(autoincrement())
  endpoint   String
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  status     String   // "ok" | "error" | "rate_limited" | "pending"
  message    String?
}

// One row per /draftpool pull during an active draft — cheap, so keeping
// history (rather than overwriting) lets you see the pool shrink pick by
// pick if you ever want to look back at draft-day velocity.
model DraftPoolSnapshot {
  id                Int      @id @default(autoincrement())
  draftYear         Int
  asOf              DateTime @default(now())
  remainingCount    Int
  remainingPlayerIds Json    // array of player IDs still in the pool at this moment
}

// From /gamehistory — StatsPlus retains this itself (all games since the
// league started using it), so this is a local cache for fast dashboard
// queries more than an "or it's lost forever" archive. gameId is stable
// per the API docs' own example, unlike PlateAppearance's row id below.
model GameBox {
  gameId           String   @id
  leagueId         Int?
  homeTeamId       Int
  awayTeamId       Int
  attendance       Int?
  date             String   // "YYYY-MM-DD" as given
  time             String?  // "HHMM" local start time
  gameType         Int      // 0 regular, 1 exhibition, 2 spring, 3 playoffs, 4 all-star, 5/6 winter, 8 2nd all-star
  played           Boolean  @default(true)
  dh               Int?     // doubleheader game number, NOT designated-hitter
  innings          Int?
  runsAway         Int?
  runsHome         Int?
  hitsAway         Int?
  hitsHome         Int?
  errorsAway       Int?
  errorsHome       Int?
  winningPitcherId Int?
  losingPitcherId  Int?
  savePitcherId    Int?
  starterAwayId    Int?
  starterHomeId    Int?
  cup              Boolean  @default(false)
  raw              Json?

  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([date])
}

// From /atbats — one row per plate appearance. UNLIKE /gamehistory, this
// is CURRENT-SEASON-ONLY at the source and gets wiped/rebuilt each import,
// so this table is the ONLY permanent record once a season passes — this
// is the reason /atbats gets synced on every 4x/day cycle indefinitely
// (including through the offseason) rather than trying to time one final
// "catch it before it's gone" pull. The source row `id` is explicitly
// documented as unstable across imports, so it is NOT used as a key here —
// dedup instead uses the natural combination of game/player/situation,
// via createMany+skipDuplicates so re-syncing the same (growing) CSV never
// creates duplicate rows.
model PlateAppearance {
  id          Int      @id @default(autoincrement())
  gameId      String
  playerId    Int      // the batter
  pitcherId   Int
  teamId      Int      // the batter's team
  leagueId    Int?
  date        String
  time        String?
  gameType    Int
  homeTeam    Int?     // team_id of the home team in that game
  inning      Int
  outs        Int      // outs BEFORE this plate appearance
  spot        Int?     // batting order spot, 1-9
  balls       Int?
  strikes     Int?
  result      Int      // see result-value table in lib/statsplus.ts comments
  sac         Boolean  @default(false)
  pinch       Boolean  @default(false)
  base1       Boolean  @default(false)
  base2       Boolean  @default(false)
  base3       Boolean  @default(false)
  close       Boolean  @default(false)
  runDiff     Int?
  rbi         Int?
  r           Int?
  sb          Int?
  cs          Int?
  hitLoc      String?
  hitXy       String?
  exitVelo    Float?
  launchAngle Float?
  sprintSpeed Float?

  @@unique([gameId, playerId, pitcherId, inning, outs, spot])
  @@index([playerId])
  @@index([pitcherId])
  @@index([teamId])
  @@index([gameId])
}

