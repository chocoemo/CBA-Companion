# Postgres connection string. On Vercel, add a Postgres storage (Vercel
# Postgres or Neon/Supabase integration) and it will inject this for you.
DATABASE_URL="postgresql://user:password@host:5432/cba_companion"

# From https://statsplus.net/cba/ -> Preferences page. Valid for 90 days;
# the API tells the app plainly when it's expired so you'll know to refresh it.
STATSPLUS_TOKEN=""

# The league's URL slug: https://statsplus.net/cba -> "cba"
STATSPLUS_LGURL="cba"

# A password you make up yourself (any random string is fine, e.g. from
# https://1password.com/password-generator/). This protects your /api/sync/*
# endpoints from being called by strangers who find your app's URL — it is
# NOT your StatsPlus token, just a lock you and GitHub Actions both know.
SYNC_SECRET=""
